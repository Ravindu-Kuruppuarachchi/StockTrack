// Filename: Jenkinsfile.deploy
pipeline {
    agent any // run on any available agent(node)/ place that runs the pipeline(built In node)

    // to give a spesific agent run code : agent { label 'linux-worker' }
    
    parameters {
        // Add Kubernetes Namespace
        string(name: 'NAMESPACE', defaultValue: 'inventory-ns', description: 'Kubernetes Namespace')
        // Which Service to Deploy
        choice(name: 'SERVICE', choices: ['App', 'Database', 'Both'], description: 'Service to Deploy')
        // Docker Image Tag to deploy
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker Image Tag to deploy')
        // Repo URL for Helm Charts
        string(name: 'REPO_URL', defaultValue: 'git@github.com:Ravindu-Kuruppuarachchi/StockTrack.git', description: 'Repo containing Helm Charts')
        // Branch containing Helm Charts
        string(name: 'BRANCH', defaultValue: 'main', description: 'Branch containing Helm Charts')  

    }

    environment {
        APP_RELEASE = 'app-release'
        DB_RELEASE  = 'db-release'
    }

    stages {
        stage('Checkout Helm Charts') {
            steps {
                dir('charts') { // We checkout the Helm charts into a subfolder named 'charts'
                    git branch: params.BRANCH, url: params.REPO_URL, credentialsId: 'github-ssh-key'
                } 
            } 
        }     

        stage('Deploy') {
            steps {
                dir('charts') { 
                    script {
                        withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {
                            
                            // --- DATABASE ---
                            if (params.SERVICE == 'Database' || params.SERVICE == 'Both') {
                                echo "Deploying Database..."
                                sh """
                                    helm upgrade --install ${DB_RELEASE} ./helm/inventory-app \
                                    -f ./helm/inventory-app/values-db.yaml \
                                    --set postgresql.image.tag=${params.IMAGE_TAG} \
                                    --namespace ${params.NAMESPACE} \
                                    --create-namespace
                                """// take docker image name from values file, jenkins will overide the tag in values with --set
                            }

                            // --- APP ---
                            if (params.SERVICE == 'App' || params.SERVICE == 'Both') {
                                echo "Deploying App..."
                                sh """
                                    helm upgrade --install ${APP_RELEASE} ./helm/inventory-app \
                                    -f ./helm/inventory-app/values-app.yaml \
                                    --set image.tag=${params.IMAGE_TAG} \
                                    --namespace ${params.NAMESPACE} \
                                    --create-namespace
                                """ // take docker image name from values file, jenkins will overide the tag in values with --set
                            }
                        }
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                script {
                    withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {

                        echo "VERIFYING DEPLOYMENT HEALTH"

                        if (params.SERVICE == 'App' || params.SERVICE == 'Both') {
                            echo "Waiting for App Pods to be ready..."
                            // This command waits 60 seconds until the deployment is successful. if not, it will timeout and mark the build as failed.
                            sh "kubectl rollout status deployment -n ${params.NAMESPACE} --timeout=60s"
                        }
                        
                        if (params.SERVICE == 'Database' || params.SERVICE == 'Both') {
                            echo "Waiting for Database Pods to be ready..."
                            sh "kubectl rollout status deployment -n ${params.NAMESPACE} --timeout=60s"
                        }
                    }
                }
            }
        }
    }
}
