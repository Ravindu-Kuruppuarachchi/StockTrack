// Filename: Jenkinsfile.deploy
pipeline {
    agent any
    
    parameters {
        choice(name: 'SERVICE', choices: ['App', 'Database', 'Both'], description: 'Which service to deploy?')
        
        // PARAM 1: The App Version
        string(name: 'APP_TAG', defaultValue: 'latest', description: 'APP Version to deploy (e.g. 15)')
        
        // PARAM 2: The DB Version (NEW)
        string(name: 'DB_TAG', defaultValue: 'latest', description: 'DATABASE Version to deploy (e.g. 5)')
    }

    environment {
        NAMESPACE    = 'inventory-ns'
        APP_RELEASE  = 'app-release'
        DB_RELEASE   = 'db-release'
    }

    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Deploy Selection') {
            steps {
                script {
                    withCredentials([file(credentialsId: 'kubeconfig-file', variable: 'KUBECONFIG')]) {
                        
                        // --- LOGIC: DATABASE ---
                        if (params.SERVICE == 'Database' || params.SERVICE == 'Both') {
                            echo "--- Deploying DATABASE: Tag ${params.DB_TAG} ---"
                            
                            withCredentials([string(credentialsId: 'db-password', variable: 'DB_PASS')]) {
                                sh """
                                    helm upgrade --install ${DB_RELEASE} ./helm/inventory-app \
                                    -f ./helm/inventory-app/values-db.yaml \
                                    --set postgresql.image.tag=${params.DB_TAG} \
                                    --set postgresql.auth.postgresPassword="${DB_PASS}" \
                                    --namespace ${NAMESPACE} \
                                    --create-namespace
                                """
                                sh "kubectl rollout status statefulset/inventory-app-statefulset -n ${NAMESPACE}"
                            }
                            echo "--- Database Deployed Successfully ---"
                        }

                        // --- LOGIC: APP ---
                        if (params.SERVICE == 'App' || params.SERVICE == 'Both') {
                            echo "--- Deploying APP: Tag ${params.APP_TAG} ---"
                            
                            withCredentials([string(credentialsId: 'app-admin-password', variable: 'ADMIN_PASS'),
                                             string(credentialsId: 'db-password', variable: 'DB_PASS')]) {
                                
                                def DB_URL = "postgresql://postgres:${DB_PASS}@postgres-service:5432/inventory_db"
                                
                                sh """
                                    helm upgrade --install ${APP_RELEASE} ./helm/inventory-app \
                                    -f ./helm/inventory-app/values-app.yaml \
                                    --set image.tag=${params.APP_TAG} \
                                    --set secrets.adminPassword="${ADMIN_PASS}" \
                                    --set myConfigMaps.app.data.database-url="${DB_URL}" \
                                    --namespace ${NAMESPACE} \
                                    --create-namespace
                                """
                                sh "kubectl rollout status deployment/inventory-app -n ${NAMESPACE}"
                            }
                            echo "--- App Deployed Successfully ---"
                        }
                    }
                }
            }
        }
    }
}