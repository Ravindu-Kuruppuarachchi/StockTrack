// Filename: Jenkinsfile.controller
pipeline {
    agent any
    
    // This creates a dropdown menu in Jenkins!
    parameters {
        choice(name: 'DEPLOY_TARGET', choices: ['App-Only', 'DB-Only', 'Full-Stack'], description: 'What do you want to deploy?')
    }

    stages {
        stage('Orchestrate') {
            steps {
                script {
                    echo "User selected: ${params.DEPLOY_TARGET}"
                    
                    if (params.DEPLOY_TARGET == 'DB-Only' || params.DEPLOY_TARGET == 'Full-Stack') {
                        echo "Triggering Database Pipeline..."
                        // 'wait: true' means we wait for DB to finish before moving on
                        build job: 'Inventory-DB-Pipeline', wait: true
                    }
                    
                    if (params.DEPLOY_TARGET == 'App-Only' || params.DEPLOY_TARGET == 'Full-Stack') {
                        echo "Triggering App Pipeline..."
                        build job: 'Inventory-App-Pipeline', wait: false
                    }
                }
            }
        }
    }
}