// Filename: Jenkinsfile.db
pipeline {
    agent any
    stages {
        stage('Checkout') { steps { checkout scm } }

        stage('Validate Config') {
            steps {
                script {
                    echo "Validating Database Configuration..."
                    // Check if the Helm chart syntax is valid
                    sh "helm lint ./helm/inventory-app -f ./helm/inventory-app/values-db.yaml"
                }
            }
        }
    }
    post {
        success {
            echo "SUCCESS: Database configuration is valid."
        }
    }
}